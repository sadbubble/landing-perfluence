# Скопируйте в .env.local и подставьте значения из Supabase → Settings → API.
# Anon-ключ публичен по замыслу, данные закрыты политиками RLS.
# service_role ключ сюда НЕ добавлять — он живёт только в секретах Edge Functions.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key
